# Copy to .env and fill in. .env is gitignored.
#
# Kalshi API key id (from the Kalshi web app -> Account -> API keys).
KALSHI_API_KEY_ID=

# Path to the RSA private key (.pem) downloaded when you created the API key.
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

# Default environment if --env is not passed: paper | demo | live
# paper = simulated fills, no orders sent (default, safe)
# demo  = real orders against Kalshi's demo sandbox
# live  = real orders against production (requires confirm_live in config.json)
KALSHI_ENV=paper
